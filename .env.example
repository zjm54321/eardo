# Copy to .env for local development. Never put real credentials in version control.
# Production: /etc/eardo/prod.env and /etc/eardo/dev.env on the VM (see docs/handover.md). Use KEY=value (no spaces around =).
ALIYUN_API_KEY=replace-with-beijing-model-studio-key
# Optional alias when ALIYUN_API_KEY is absent (server startup expects ALIYUN_API_KEY).
# DASHSCOPE_API_KEY=replace-with-beijing-model-studio-key
PG_DATABASE_URL=postgres://postgres:postgres@localhost:5432/eardo
PG_MAX_CONNECTIONS=5
MAX_BODY_BYTES=4194304
SHUTDOWN_TIMEOUT_SECS=25
# Set true for HTTPS deployments (also automatically enabled by LEPTOS_ENV=PROD).
COOKIE_SECURE=false
# Optional comma-separated browser origins; omit for same-origin requests only.
# ALLOWED_ORIGINS=https://eardoai.com

# TTS total deadline includes semaphore wait, synthesis, and audio download (1..600s).
TTS_TIMEOUT_SECS=60
# Global in-process provider-call concurrency (1..64); default 2.
TTS_MAX_CONCURRENCY=2
# Audio responses are limited to 20 MiB. WebSocket connect/read: 10s/30s.
# Seeded Qwen voices use qwen3-tts-flash; CosyVoice system voices use v3-flash.
# qwen-audio-3.1-tts-flash needs its own voice IDs (e.g. longanhuan_v3.1).
# CosyVoice v3.5 and legacy Qwen VC/VD need enrollment, not built-in voices.

# Optional OpenRouter primary; omit its key to use verified DashScope chat directly.
# Paid-model requests need account credits. Free-provider probes returned HTTP 429.
# OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_BASE=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=https://eardoai.com
OPENROUTER_APP_NAME=EarDo
# Used if OpenRouter is unconfigured, unavailable, rate-limited, or out of credits.
DASHSCOPE_CHAT_MODEL=qwen-flash
# Per LLM provider attempt (1..120s); JSON response limit 1 MiB.
LLM_TIMEOUT_SECS=30

# Leptos server configuration (also supported by the framework).
LEPTOS_ENV=DEV
LEPTOS_SITE_ADDR=127.0.0.1:3000
LEPTOS_SITE_ROOT=target/site
LEPTOS_SITE_PKG_DIR=pkg
LEPTOS_OUTPUT_NAME=eardo
LEPTOS_RELOAD_PORT=3001
# Optional framework overrides:
# LEPTOS_RELOAD_EXTERNAL_PORT=3001
# LEPTOS_RELOAD_WS_PROTOCOL=ws
# LEPTOS_HASH_FILES=false
# LEPTOS_HASH_FILE_NAME=hash.txt
